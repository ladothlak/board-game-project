# Web server port for `next dev` / `next start`. Default: 3111.
PORT=3111

# Unsloth runs locally (Unsloth Studio / `unsloth run`) and exposes an
# OpenAI-compatible API. Point these at your local instance.
UNSLOTH_API_KEY=sk-unsloth-your-key-here
UNSLOTH_BASE_URL=http://localhost:8888/v1
UNSLOTH_MODEL=ukisai/Swift-1.5-Qwen3.8-27B-GSQ-RCO-GGUF

# Use the fast decision model (kev-0.8b via /systemone) for query
# classification and candidate relevance scoring in the RAG pipeline instead
# of the keyword heuristic + slow LLM re-rank. See PERFORMANCE-PLAN.md
# ("Decision-model RAG"). Default on; set USE_DECISION_MODEL=0 to disable
# for A/B benchmarking.
USE_DECISION_MODEL=1

# Brave Search API key for rulebook web search (https://api.search.brave.com/app/)
BRAVE_SEARCH_API_KEY=your-brave-search-key-here

# Optional: bearer token to protect LLM-burning and personal-data endpoints.
# When set, requests to /api/chat, /api/find-game, /api/games (POST), etc.
# must include "Authorization: Bearer <token>" or a "parlor_token" cookie.
# When unset, those endpoints are open (suitable for localhost-only use).
PARLOR_AUTH_TOKEN=

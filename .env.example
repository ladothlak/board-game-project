# Unsloth runs locally (Unsloth Studio / `unsloth run`) and exposes an
# OpenAI-compatible API. Point these at your local instance.
UNSLOTH_API_KEY=sk-unsloth-your-key-here
UNSLOTH_BASE_URL=http://localhost:8888/v1
UNSLOTH_MODEL=ukisai/Swift-1.5-Qwen3.8-27B-GSQ-RCO-GGUF

# Brave Search API key for rulebook web search (https://api.search.brave.com/app/)
BRAVE_SEARCH_API_KEY=your-brave-search-key-here

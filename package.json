{
  "name": "board-game-parlor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "sh -c 'set -a; . ./.env 2>/dev/null || true; set +a; exec next dev -p ${PORT:-3111}'",
    "build": "npm run build:search && next build",
    "start": "sh -c 'set -a; . ./.env 2>/dev/null || true; set +a; exec next start -p ${PORT:-3111}'",
    "build:search": "node scripts/build-index.mjs",
    "backup": "node scripts/backup.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "grade": "tsx scripts/grade-retrieval.ts"
  },
  "dependencies": {
    "next": "^15.3.0",
    "pdfjs-dist": "^4.8.69",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
